NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase auth/database. Run web/supabase/schema.sql before enabling these.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Required in production. Used to encrypt job_inputs.account_text at rest.
JOB_INPUT_ENCRYPTION_KEY=replace-with-long-random-secret

# Optional local worker bridge. Vercel uses WORKER_API_BASE.
BLOCKMESH_LOCAL_WORKER=0
BLOCKMESH_CLI_DIR=C:\BlockMeshCLI
BLOCKMESH_EXE=C:\BlockMeshCLI\blockmesh.exe

# Admin seed script. Set ADMIN_PASSWORD locally before running npm run seed:admin.
ADMIN_EMAIL=admin@blockmesh.local
ADMIN_PASSWORD=

# External worker backend. The web app dispatches jobs server-side to this worker.
WORKER_API_BASE=https://worker.your-domain.com
WORKER_API_TOKEN=replace-with-worker-token

# Discord bot API. BOT_API_TOKEN must be different from WORKER_API_TOKEN.
BOT_API_TOKEN=replace-with-separate-bot-token
# Free v1 mode automatically credits the Discord shadow wallet for each job.
BOT_FREE_MODE=true

# Worker callbacks use NEXT_PUBLIC_SITE_URL:
# POST /api/worker/jobs/:jobId/status
# POST /api/worker/jobs/:jobId/complete

# Payment mode:
# placeholder = local UI testing only
# angpao = redeem directly to ANGPAO_PHONE through TrueMoney's gift-voucher endpoint
# truemoney = redeem through a separate server-side provider
PAYMENT_PROVIDER_MODE=placeholder

# 0 selects production payment behavior; 1 selects placeholder top-up behavior.
ALLOW_PLACEHOLDER_TOPUP=0

# Queue safety guard. Users cannot confirm more queued/running/retrying jobs than this.
MAX_ACTIVE_JOBS_PER_USER=2

# Direct Angpao mode. Keep the receiving phone server-side and never expose it as NEXT_PUBLIC_*.
# The upstream gift-voucher endpoint is not an official public API and may change without notice.
ANGPAO_PHONE=

# Voucher provider contract. The provider must accept:
# POST {TRUEMONEY_API_BASE}/{TRUEMONEY_REDEEM_PATH}
# Authorization: Bearer TRUEMONEY_API_TOKEN
# Idempotency-Key: voucher:<sha256>
# JSON body: {"voucherUrl":"https://gift.truemoney.com/...","reference":"voucher:<sha256>"}
# It must return accepted/success, amountBaht/amount, and transactionId/referenceId.
TRUEMONEY_API_BASE=
TRUEMONEY_API_TOKEN=
TRUEMONEY_REDEEM_PATH=v1/vouchers/redeem
TRUEMONEY_TIMEOUT_MS=20000
TRUEMONEY_MAX_TOPUP_BAHT=100000

# Callback endpoint for a provider that supports the contract documented above:
# https://your-domain.com/api/payments/truemoney/webhook
TRUEMONEY_WEBHOOK_SECRET=replace-with-webhook-secret
